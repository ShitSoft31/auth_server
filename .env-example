# Django Settings
DEBUG=True                                              # False in prod. True in dev
PROJECT_DOMAIN=                                         # Required in prod. Leave blank in dev
ALLOWED_HOSTS=your-domain,other-domain                  # Required in prod. Leave blank in dev
DJANGO_SECRET_KEY=django-secret-key                     # Generate a strong key in prod.
# Postgresql Settings
PSQL_HOST=postgresql_host
PSQL_PORT=5432
PSQL_USERNAME=postgresql_username
PSQL_PASSWORD=secret_postgresql_user_password
PSQL_DBNAME=postgresql_database_name
